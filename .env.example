# Railway PostgreSQL URL. For Vercel serverless, cap the per-instance
# connection pool so concurrent functions don't exhaust Postgres. The
# `connection_limit=1` + longer `pool_timeout` pair is the standard
# Prisma-on-serverless recipe when you don't have an external pooler.
DATABASE_URL=postgresql://dev:dev@localhost:5432/pokesearch?connection_limit=1&pool_timeout=20

# 64-char random hex string. Used to sign short-lived edit/delete verify tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string-replace-with-64-char-random-hex

# Absolute origin of the deployed site. Used for canonical URLs, OpenGraph,
# robots.txt, and sitemap.xml. Must include scheme and no trailing slash.
# In development this can be left empty to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://pokesearch.example.com

# Upstash Redis (used for comment + team-verify rate limiting). Required in
# production on Vercel serverless — in-memory counters don't survive across
# instances. Create a free DB at https://upstash.com/ or install the Upstash
# integration from the Vercel Marketplace, which injects both vars.
# If left empty in local dev, the rate limiter falls back to in-memory state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
