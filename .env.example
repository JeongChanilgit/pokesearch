DATABASE_URL=postgresql://dev:dev@localhost:5432/pokesearch

# 64-char random hex string. Used to sign short-lived edit/delete verify tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex-string-replace-with-64-char-random-hex

# Absolute origin of the deployed site. Used for canonical URLs, OpenGraph,
# robots.txt, and sitemap.xml. Must include scheme and no trailing slash.
# In development this can be left empty to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://pokesearch.example.com
